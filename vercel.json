{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci --omit=dev",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/inquiry.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/agency",
      "destination": "/marketing",
      "permanent": true
    }
  ]
}
